{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfReview configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "scopes",
    "projects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalog": {
      "type": "string"
    },
    "bestPractices": {
      "type": "boolean"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "extends": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "disabledRules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "root",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
