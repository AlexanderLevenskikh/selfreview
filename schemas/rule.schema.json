{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SelfReview rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "family",
    "title",
    "description",
    "scope",
    "status",
    "severity",
    "mode",
    "check",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
    },
    "scope": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "overrideReason": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "rejected"
      ]
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "mode": {
      "enum": [
        "enforce",
        "advisory"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 20000
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "by",
        "reason",
        "behaviorHash"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        },
        "behaviorHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "observations": {
      "type": "object"
    },
    "rejection": {
      "type": "object"
    },
    "examples": {},
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-var"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-console"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowMethods": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 100
                }
              },
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-debugger"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "strict-equality"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowNull": {
                  "type": "boolean"
                }
              },
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "restricted-import"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "modules": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 100,
                  "minItems": 1
                }
              },
              "required": [
                "modules"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "restricted-call"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "callees": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxItems": 100,
                  "minItems": 1
                }
              },
              "required": [
                "callees"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "function-max-lines"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              },
              "required": [
                "max"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "component-max-lines"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              },
              "required": [
                "max"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "max-parameters"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              },
              "required": [
                "max"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "no-async-promise-executor"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "require-braces"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "manual"
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {},
              "required": []
            }
          }
        }
      ]
    }
  }
}
